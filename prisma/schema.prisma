generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider     = "postgresql"
  url          = env("DATABASE_URL")
  relationMode = "prisma"
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Client {
  id             String          @id @default(cuid())
  firstName      String
  lastName       String
  email          String          @unique
  phone          String?
  eventDate      DateTime?       // Deprecated - use Event model instead
  notes          String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  eventType      String?         // Deprecated - use Event model instead
  eventLocation  String?         // Deprecated - use Event model instead
  eventStartTime String?          // Deprecated - use Event model instead
  eventDuration  String?          // Deprecated - use Event model instead
  eventPackage   String?         // Deprecated - use Event model instead
  packagePrice   Decimal?        @db.Decimal(10, 2) // Deprecated - use Event model instead
  address        String?
  addressAddedAt DateTime?
  phoneAddedAt   DateTime?
  isWhitelabelClient Boolean       @default(false)
  agreements     Agreement[]
  sessions       ClientSession[]
  clientNotes    ClientNote[]    @relation("ClientNotes")
  events         Event[]
  files          ClientFile[]
  leads          Lead[]
}

model Template {
  id            String           @id @default(cuid())
  title         String
  htmlContent   String
  version       Int              @default(1)
  fieldsSchema  Json
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  internalTitle String?
  order         Int              @default(0)
  agreements    Agreement[]
  fields        AgreementField[]
}

model Agreement {
  id                 String                @id @default(cuid())
  clientId           String
  templateId         String
  eventId            String?                // Optional link to specific event
  status             AgreementStatus       @default(DRAFT)
  uniqueToken        String                @unique
  expiresAt          DateTime?
  mergedHtml         String?
  customHtmlContent  String?
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
  signedAt           DateTime?
  signedFromIP       String?
  cancelledAt        DateTime?
  cancelledBy        String?
  cancellationReason String?
  archived           Boolean               @default(false)
  archivedAt         DateTime?
  lastEmailedAt      DateTime?
  emailSendCount     Int                   @default(0)
  firstViewedAt      DateTime?
  lastViewedAt       DateTime?
  viewCount          Int                   @default(0)
  
  // Portal enhancement fields
  paymentStatus      String?
  stripePaymentLink  String?
  stripeReceiptLink  String?
  galleryLink        String?   // Deprecated: use galleryLinks. Kept for backward compatibility.
  galleryLinks       Json?     // Array of { title: string, url: string } for multiple galleries
  galleryEmailSentAt DateTime?
  nextAction         String?
  backdropLinkId     String?
  backdropLink       BackdropLink?         @relation(fields: [backdropLinkId], references: [id], onDelete: SetNull)
  selectedBackdropName String?
  showPhoneNumberAlways Boolean            @default(false)
  forceVirtualGreenScreen Boolean          @default(false)

  // Second signer (optional)
  secondSignerEnabled    Boolean           @default(false)
  secondSignerFirstName  String?
  secondSignerLastName   String?
  secondSignerEmail      String?
  secondSignerPhone      String?
  requireBothSignatures  Boolean           @default(false)

  leadId             String?    @unique
  client             Client                @relation(fields: [clientId], references: [id])
  template           Template              @relation(fields: [templateId], references: [id])
  event              Event?                @relation(fields: [eventId], references: [id], onDelete: SetNull)
  lead               Lead?                 @relation(fields: [leadId], references: [id], onDelete: SetNull)
  fields             AgreementFieldValue[]
  signatures         Signature[]
  auditLogs          AuditLog[]
  notes              ClientNote[]

  @@index([secondSignerEmail])
}

model AgreementField {
  id               String   @id @default(cuid())
  templateId       String
  key              String
  label            String
  type             String
  editableByClient Boolean  @default(false)
  required         Boolean  @default(false)
  template         Template @relation(fields: [templateId], references: [id])

  @@unique([templateId, key])
}

model AgreementFieldValue {
  id          String    @id @default(cuid())
  agreementId String
  key         String
  value       String
  agreement   Agreement @relation(fields: [agreementId], references: [id])

  @@unique([agreementId, key])
}

model Signature {
  id          String    @id @default(cuid())
  agreementId String
  signerName  String
  signerEmail String
  method      String
  imageUrl    String?
  typedFont   String?
  signedAt    DateTime  @default(now())
  ip          String?
  userAgent   String?
  contentHash String?
  agreement   Agreement @relation(fields: [agreementId], references: [id])

  @@unique([agreementId, signerEmail])
  @@index([agreementId])
}

model AuditLog {
  id          String     @id @default(cuid())
  agreementId String?
  actor       String
  action      String
  metadata    Json?
  createdAt   DateTime   @default(now())
  agreement   Agreement? @relation(fields: [agreementId], references: [id])
}

model ClientSession {
  id             String   @id @default(cuid())
  clientEmail    String?
  secondaryEmail String?
  sessionToken   String   @unique
  expiresAt      DateTime
  createdAt      DateTime @default(now())
  lastActivityAt DateTime @default(now())
  client         Client?  @relation(fields: [clientEmail], references: [email])

  @@index([clientEmail])
  @@index([secondaryEmail])
}

model ClientNote {
  id          String     @id @default(cuid())
  clientId    String
  agreementId String?
  content     String
  createdAt   DateTime   @default(now())
  client      Client     @relation("ClientNotes", fields: [clientId], references: [id])
  agreement   Agreement? @relation(fields: [agreementId], references: [id])

  @@index([clientId])
  @@index([agreementId])
}

model BackdropLink {
  id           String      @id @default(uuid())
  name         String
  url          String
  displayOrder Int         @default(0)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  agreements   Agreement[]

  @@index([displayOrder])
}

model AttendantGroup {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  attendantIds String[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([slug])
}

model Event {
  id             String      @id @default(cuid())
  clientId       String
  eventDate      DateTime?
  eventType      String?
  eventLocation  String?
  eventStartTime String?
  eventDuration  String?
  eventPackage   String?
  packagePrice   Decimal?   @db.Decimal(10, 2)
  notes          String?
  eventName      String?
  eventPhone     String?
  unlimitedPrints Boolean   @default(false)
  archived       Boolean    @default(false)
  archivedAt     DateTime?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  
  client         Client      @relation(fields: [clientId], references: [id], onDelete: Cascade)
  agreements     Agreement[]
  files          ClientFile[]
  leads          Lead[]

  @@index([clientId])
  @@index([archived])
}

model ClientFile {
  id                  String    @id @default(cuid())
  clientId            String
  eventId             String?
  fileName             String
  fileType             String
  fileSize             Int
  googleDriveFileId    String
  googleDriveLink      String
  googleDriveFolderId  String
  uploadedBy           String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  
  client               Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  event                Event?    @relation(fields: [eventId], references: [id], onDelete: SetNull)

  @@index([clientId])
  @@index([eventId])
}

model Settings {
  id        String   @id @default(cuid())
  key       String   @unique
  value     Json
  updatedAt DateTime @updatedAt
}

enum AgreementStatus {
  DRAFT
  SENT
  SIGNED
  VOID
  LIVE
  COMPLETED
  CANCELLED
}

enum LeadStage {
  QUOTE_REQUESTED
  QUOTE_SENT
  AGREEMENT_SENT
  SIGNED
  COMPLETED
  LOST
}

enum LeadSource {
  QUOTE
  MANUAL
}

model PortalOtpVerification {
  id             String    @id @default(cuid())
  email          String    @unique
  code           String
  expiresAt      DateTime
  failedAttempts Int       @default(0)
  lockedUntil    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model OtpRequestLog {
  id        String   @id @default(cuid())
  email     String
  ip        String
  createdAt DateTime @default(now())

  @@index([email, createdAt])
  @@index([ip, createdAt])
}

model Lead {
  id               String     @id @default(cuid())
  source           LeadSource @default(QUOTE)
  stage            LeadStage  @default(QUOTE_REQUESTED)
  notes            String?
  
  // Contact (may exist before Client)
  firstName        String
  lastName         String
  email            String
  phone            String?
  eventDate        DateTime?
  eventType        String?
  eventLocation    String?
  
  // Quote snapshot (for QUOTE source)
  quotePackageHours Int?
  quoteTotal       Decimal?   @db.Decimal(10, 2)
  quotePdfUrl      String?
  
  // Follow-up
  lastContactedAt  DateTime?
  nextFollowUpAt   DateTime?
  contactCount     Int        @default(0)
  
  // Links (when converted)
  clientId         String?
  eventId          String?
  
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
  
  client           Client?    @relation(fields: [clientId], references: [id], onDelete: SetNull)
  event            Event?     @relation(fields: [eventId], references: [id], onDelete: SetNull)
  agreement        Agreement?
  
  @@index([stage])
  @@index([nextFollowUpAt])
  @@index([email])
}
