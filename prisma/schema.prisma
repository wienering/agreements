generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider     = "postgresql"
  url          = env("DATABASE_URL")
  relationMode = "prisma"
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Client {
  id             String          @id @default(cuid())
  firstName      String
  lastName       String
  email          String          @unique
  phone          String?
  eventDate      DateTime?
  notes          String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  eventType      String?
  eventLocation  String?
  eventStartTime String?
  eventDuration  String?
  eventPackage   String?
  packagePrice   Decimal?        @db.Decimal(10, 2)
  address        String?
  addressAddedAt DateTime?
  phoneAddedAt   DateTime?
  agreements     Agreement[]
  sessions       ClientSession[]
  clientNotes    ClientNote[]    @relation("ClientNotes")
}

model Template {
  id            String           @id @default(cuid())
  title         String
  htmlContent   String
  version       Int              @default(1)
  fieldsSchema  Json
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  internalTitle String?
  order         Int              @default(0)
  agreements    Agreement[]
  fields        AgreementField[]
}

model Agreement {
  id                 String                @id @default(cuid())
  clientId           String
  templateId         String
  status             AgreementStatus       @default(DRAFT)
  uniqueToken        String                @unique
  expiresAt          DateTime?
  mergedHtml         String?
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
  signedAt           DateTime?
  signedFromIP       String?
  cancelledAt        DateTime?
  cancelledBy        String?
  cancellationReason String?
  archived           Boolean               @default(false)
  archivedAt         DateTime?
  lastEmailedAt      DateTime?
  emailSendCount     Int                   @default(0)
  firstViewedAt      DateTime?
  lastViewedAt       DateTime?
  viewCount          Int                   @default(0)
  
  // Portal enhancement fields
  paymentStatus      String?
  stripePaymentLink  String?
  stripeReceiptLink  String?
  galleryLink        String?
  nextAction         String?
  backdropLinkId     String?
  backdropLink       BackdropLink?         @relation(fields: [backdropLinkId], references: [id], onDelete: SetNull)
  selectedBackdropName String?
  
  client             Client                @relation(fields: [clientId], references: [id])
  template           Template              @relation(fields: [templateId], references: [id])
  fields             AgreementFieldValue[]
  signature          Signature?
  auditLogs          AuditLog[]
  notes              ClientNote[]
}

model AgreementField {
  id               String   @id @default(cuid())
  templateId       String
  key              String
  label            String
  type             String
  editableByClient Boolean  @default(false)
  required         Boolean  @default(false)
  template         Template @relation(fields: [templateId], references: [id])

  @@unique([templateId, key])
}

model AgreementFieldValue {
  id          String    @id @default(cuid())
  agreementId String
  key         String
  value       String
  agreement   Agreement @relation(fields: [agreementId], references: [id])

  @@unique([agreementId, key])
}

model Signature {
  id          String    @id @default(cuid())
  agreementId String    @unique
  signerName  String
  signerEmail String
  method      String
  imageUrl    String?
  typedFont   String?
  signedAt    DateTime  @default(now())
  ip          String?
  userAgent   String?
  contentHash String?
  agreement   Agreement @relation(fields: [agreementId], references: [id])
}

model AuditLog {
  id          String     @id @default(cuid())
  agreementId String?
  actor       String
  action      String
  metadata    Json?
  createdAt   DateTime   @default(now())
  agreement   Agreement? @relation(fields: [agreementId], references: [id])
}

model ClientSession {
  id             String   @id @default(cuid())
  clientEmail    String
  sessionToken   String   @unique
  expiresAt      DateTime
  createdAt      DateTime @default(now())
  lastActivityAt DateTime @default(now())
  client         Client   @relation(fields: [clientEmail], references: [email])

  @@index([clientEmail])
}

model ClientNote {
  id          String     @id @default(cuid())
  clientId    String
  agreementId String?
  content     String
  createdAt   DateTime   @default(now())
  client      Client     @relation("ClientNotes", fields: [clientId], references: [id])
  agreement   Agreement? @relation(fields: [agreementId], references: [id])

  @@index([clientId])
  @@index([agreementId])
}

model BackdropLink {
  id           String      @id @default(uuid())
  name         String
  url          String
  displayOrder Int         @default(0)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  agreements   Agreement[]

  @@index([displayOrder])
}

enum AgreementStatus {
  DRAFT
  SENT
  SIGNED
  VOID
  LIVE
  COMPLETED
  CANCELLED
}
