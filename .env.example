# Database
DATABASE_URL="postgresql://user:password@host/database?sslmode=require&pgbouncer=true&connection_limit=10&pool_timeout=60&connect_timeout=30"

# NextAuth
NEXTAUTH_SECRET="your-secret-key-here"
NEXTAUTH_URL="https://agreements.photoboothguys.ca"

# App URL (for links in emails, etc.)
NEXT_PUBLIC_BASE_URL="https://agreements.photoboothguys.ca"

# Admin
ADMIN_EMAIL="agreements@photoboothguys.ca"
# Optional: Where to send "Agreement Viewed" alerts (defaults to ADMIN_EMAIL if unset)
# VIEW_ALERT_EMAIL="info@photoboothguys.ca"

# Quote webhook (optional) - Website form at https://www.photoboothguys.ca/photobooth-quotes/ sends Step 1 data here
# QUOTE_WEBHOOK_SECRET=""  # Leave unset for no auth, or set a secret and add it to Quotes/php/config.php

# Backdrop selection form (required for client submissions to POST /api/agreements/update-backdrop-selection)
# BACKDROP_FORM_SECRET="generate-a-long-random-string"

# Bookly service-extra ID for the "Unlimited Prints" add-on. When an inbound
# Bookly webhook's `extras` payload contains this key with quantity >= 1, the
# created Event row's unlimitedPrints flag is auto-set to true. Defaults to "2"
# if unset. Confirm the ID in your Bookly admin (bookly_service_extras table).
BOOKLY_UNLIMITED_PRINTS_EXTRA_ID="2"

# SMTP (Email)
SMTP_HOST="your-smtp-host"
SMTP_PORT="587"
SMTP_USER="your-smtp-user"
SMTP_PASS="your-smtp-password"
SMTP_FROM="agreements@photoboothguys.ca"
